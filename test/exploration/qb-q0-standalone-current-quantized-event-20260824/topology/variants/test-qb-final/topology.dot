digraph topology {
graph [rankdir=LR, splines=polyline, overlap=false, nodesep=0.32, ranksep=1.0, pad=0.3, bgcolor="white"];
node [fontname="DejaVu Sans", fontsize=9, margin="0.08,0.05"];
edge [fontname="DejaVu Sans", fontsize=8, color="#65758b"];
label="qb-q0-standalone-current-quantized-event-20260824 — structural variant test-qb-final\nsource: test/exploration/qb-q0-standalone-current-quantized-event-20260824/inputs/test_qb_final.cir"; labelloc=t; fontsize=16; fontname="DejaVu Sans";
