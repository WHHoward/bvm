EXPERIMENT_ID=bvm-4x4-diagonal-array-v1-20261009
CASE=PAPER_1101_1101
DRIVE_MODE=SHARED
SE_TOPOLOGY=CELL
SE_GATE_MODE=CROSSPOINT
ROW_BITS=1101
COL_BITS=1101
# Four rows, four columns, row-major; leftmost cell is R1C1.
SE_ENABLE_MASK=ALL
OUTPUT_MODE=DIAGONAL_TERMINAL
