# BVM 4x4 local experiment controls.
# Edit THIS file and run ./configure.sh; no JoSIM is launched.
# All timing values are in picoseconds (ps).

CASE_NAME=V3_15x15_T70
A=15
B=15
ROUNDS=3

# Period between successive SE read starts
READ_INTERVAL_PS=80
# Empty = same as READ_INTERVAL_PS
CLOCK_PERIOD_PS=80
# Empty = same as READ_INTERVAL_PS; clock means PWL start (not actual JJ clock arrival)
SE_CLOCK_DELAY_PS=68

WRITE_START_PS=50
FIRST_READ_PS=110
DT_PS=0.01
TAIL_PS=70
# Empty = choose STOP automatically
STOP_PS=

# Choose outputs or outputs-clocks (add 8 clock probes)
PROBES=outputs
