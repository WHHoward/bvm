R_TRIG_CLK_D4 CLK_RAW_D4 CLK_D4 2
XT1_D4 T1_I_D4 CLK_D4 S_D4 C_D4 N_BIAS1_D4 N_BIAS2_D4 N_BIAS3_D4 T1
V_BIAS1_D5 N_BIAS1_D5 0 DC 1.8m
V_BIAS2_D5 N_BIAS2_D5 0 DC 1.8m
V_BIAS3_D5 N_BIAS3_D5 0 DC 1.8m
R_S_D5 S_D5 0 12
