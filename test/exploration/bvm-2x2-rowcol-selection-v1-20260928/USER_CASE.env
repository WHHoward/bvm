NAME=bvm_2x2_rowcol_selection
DRIVE_MODE=INDEPENDENT
ROW_BITS=10
COL_BITS=10

# Per-cell amplitudes in INDEPENDENT; per-line candidates in SHARED.
ROW_WL_READ_AMPLITUDE=100u
COL_SE_READ_AMPLITUDE=100u
ROW_WL_WRITE_AMPLITUDE=100u
COL_BL_WRITE_AMPLITUDE=100u

# Fixed uniform downstream load: QB -> one sJTL -> one CB -> R_TERM.
SJTL_PER_CELL=1
POST_CB_PER_CELL=1
TERM_R=2

DT=0.01p
STOP=250p
PROBE_PROFILE=core
