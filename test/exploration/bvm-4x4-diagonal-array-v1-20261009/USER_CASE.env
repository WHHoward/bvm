CBU_MODE=OFF
CARRY_MODE=NONE
# WL/BL values are shared BUS_SOURCE_TOTAL setpoints, not per-cell amplitudes.
# Per-BVM R_WL/R_BL/R_SE currents must be measured from each run's raw CSV.
ROW_WL_WRITE_AMPLITUDE=400u
COL_BL_WRITE_AMPLITUDE=400u
ROW_WL_READ_AMPLITUDE=400u
COL_SE_READ_AMPLITUDE=100u
DT=0.01p
STOP=250p
PROBE_PROFILE=focus
FOCUS_DIAGONAL=D3
SJTL_COUNT_D0=1
SJTL_COUNT_D1=1,1
SJTL_COUNT_D2=1,1,1
SJTL_COUNT_D3=1,2,2,1
SJTL_COUNT_D4=1,1,1
SJTL_COUNT_D5=1,1
