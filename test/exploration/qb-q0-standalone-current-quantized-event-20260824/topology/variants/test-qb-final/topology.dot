}
"n_0" [shape=ellipse, style=filled, fillcolor="#fffdf2", label="0"];
"n_IBIAS" [shape=ellipse, style=filled, fillcolor="#fffdf2", label="IBIAS"];
"n_IN1" [shape=ellipse, style=filled, fillcolor="#fffdf2", label="IN1"];
"n_OUT1" [shape=ellipse, style=filled, fillcolor="#fffdf2", label="OUT1"];
"e_XBQ" -> "n_IN1" [dir=none, label="a"];
"e_XBQ" -> "n_OUT1" [dir=none, label="b"];
"e_R_LOAD" -> "n_OUT1" [dir=none, label="a"];
"e_R_LOAD" -> "n_0" [dir=none, label="b"];
"e_I_IBIAS" -> "n_0" [dir=none, label="a"];
"e_I_IBIAS" -> "n_IBIAS" [dir=none, label="b"];
"e_I_IN" -> "n_0" [dir=none, label="a"];
"e_I_IN" -> "n_IN1" [dir=none, label="b"];
