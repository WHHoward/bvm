# Main V9 experiment entry point. Edit this file, then run ./try.sh --dry-run.
# This protocol is fixed; it never falls back to the legacy WL+SE read mode.
PROTOCOL=V9_SHARED_ROW_SE_BL

# A and B are unsigned 4-bit operands (0..15). ROUNDS repeats the same pair.
CASE_NAME=SE375_A11_B15_FULL256
A=11
B=15
ROUNDS=3

# Timing values are in ps. Clock times are PWL source starts, not measured arrivals.
READ_INTERVAL_PS=80
CLOCK_PERIOD_PS=80
SE_CLOCK_DELAY_PS=68
WRITE_START_PS=50
FIRST_READ_PS=110
DT_PS=0.01
STOP_PS=400

# Source amplitudes. SE_READ_AMPLITUDE=375u is a current candidate, not an
# experimentally established optimum. Change it explicitly for your run.
WL_WRITE_AMPLITUDE=400u
BL_WRITE_AMPLITUDE=400u
BL_READ_AMPLITUDE=400u
SE_READ_AMPLITUDE=375u

# OUTPUTS stores only the eight product-output voltage probes.
# CUSTOM adds exactly the lines in CUSTOM_PROBES_FILE to those eight probes.
PROBE_PROFILE=OUTPUTS
CUSTOM_PROBES_FILE=
