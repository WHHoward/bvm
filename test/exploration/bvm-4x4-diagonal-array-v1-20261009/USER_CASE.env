# Experiment identity only; CASE is the label saved into a new manual run.
EXPERIMENT_ID=bvm-4x4-diagonal-array-v1-20261009
# 可编辑：标签会用于新 run 目录名；旧 run ID 不会复用或覆盖。
CASE=CHAIN_ALL_GLOBAL_CLOCK

# Array input wiring. SHARED means 4 row WL buses and 4 column BL buses;
# CELL means each BVM keeps its own SE node/source.
DRIVE_MODE=SHARED
# 可选值：SHARED（当前平台唯一支持；4 条共享 WL 行线和 4 条共享 BL 列线）。
SE_TOPOLOGY=CELL
# 可选值：CELL（当前平台唯一支持；每个 BVM 的 SE 驱动节点独立）。

# FINAL_READ gate rule: a cell gets SE only when its row bit AND column bit
# are 1, additionally enabled by SE_ENABLE_MASK below.
SE_GATE_MODE=CROSSPOINT
# 可选值：CROSSPOINT（当前平台唯一支持；FINAL_READ 按行位 AND 列位交叉选通）。
# Four characters, leftmost is row/column 1. Example 1101 selects rows 1,2,4
# and columns 1,2,4; the intersection determines FINAL_READ crosspoints.
ROW_BITS=1111
# 可选格式：恰好 4 个 0/1 字符，共 16 种组合；左侧字符对应 R1。
COL_BITS=1111
# 可选格式：恰好 4 个 0/1 字符，共 16 种组合；左侧字符对应 C1。
# Optional 4x4 row-major SE permission mask: 1 enables, 0 disables;
# ALL enables all 16 cell-local SE sources.
SE_ENABLE_MASK=ALL
# 可选值：ALL，或四行 4-bit 掩码，以“/”分隔，例如 1111/1111/1111/1111。

# Output topology: terminal loads, seven independent T1s, or the registered
# physical ripple chain. Chain mode removes DOUT terminal loads.
OUTPUT_MODE=DIAGONAL_T1_CHAIN
# 可选值：DIAGONAL_TERMINAL、DIAGONAL_T1_INDEPENDENT、DIAGONAL_T1_CHAIN。
T1_MODE=CHAIN
# 可选值：OFF（TERMINAL）、ALL_INDEPENDENT（独立 T1）、CHAIN（七级链）。
# 手动运行 T1 时直接在这里选时钟模式；QUIET 不施加脉冲，PULSE 使用 T1_PARAMS.env 中的波形参数。
T1_CLK_MODE=PULSE
# 可选值：QUIET、PULSE；仅影响独立 T1 模式，CHAIN 使用下方全局时钟参数。
CBU_MODE=PHYSICAL_TWO_INPUT
# 可选值：PHYSICAL_TWO_INPUT（实验候选 THmitll_MERGE）；不等同于阵列 CB。
CARRY_MODE=RIPPLE
# 可选值：RIPPLE（真实 CBU/T1 级联）。
D0_JTL_TYPE=D0_SJTL
# 当前实现候选：D0_SJTL（由 canonical sJTL_0923 生成实验局部副本）。
D0_JTL_COUNT=1
# 可选正整数；每个 D0 入口串联相同配置的物理 sJTL，不可设为 0。
CBU_TYPE=THmitll_MERGE
# 当前候选：THmitll_MERGE（ColdFlux 双输入 a,b,q；局部语法兼容副本）。
CBU_OVERRIDE_D1=NONE
# 可选值：NONE（全部六级使用 CBU_TYPE）、CB_DIRECT（DOUT_D1 与 C_D0 共节点后进入一个 CB_0928）、CB_CARRY_BUFFER（仅 C_D0 支路先经过一个 CB_0928，再与 DOUT_D1 共节点）；两种 CB 候选均不增加 sJTL。
DFF_TYPE=THmitll_DFF
# 当前候选：THmitll_DFF（ColdFlux 三端口 a,clk,q；局部可调参数副本）。
T1_CHAIN_CLOCK_MODE=GLOBAL_ONESHOT
# 可选值：QUIET（确定的静默电阻支路）、GLOBAL_ONESHOT（所有 T1 与 DFF 同时单次触发）。
T1_CHAIN_CLK_START=200p
# 单次时钟起始时间，正数 ps；不生成周期重复脉冲。

# Drive levels are microamps (u). WL/BL values are shared-bus source setpoints,
# not per-cell currents; actual per-BVM branch currents are in raw/metrics.
ROW_WL_WRITE_AMPLITUDE=400u
# 可选格式：正的微安数值并带 u 后缀，例如 200u、400u；这是共享行总线源值。
COL_BL_WRITE_AMPLITUDE=400u
# 可选格式：正的微安数值并带 u 后缀，例如 200u、400u；这是共享列总线源值。
ROW_WL_READ_AMPLITUDE=400u
# 可选格式：正的微安数值并带 u 后缀，例如 100u、400u；不是每个 BVM 的实测电流。
COL_SE_READ_AMPLITUDE=100u
# 可选格式：正的微安数值并带 u 后缀，例如 50u、100u；实际支路电流从 raw 测量。

# Time units use ps (p). DT is the configured solver step; inspect raw timestamps
# for the actual stored grid. STOP is the simulation end time.
DT=0.01p
# 可选格式：正数 + p（ps），例如 0.01p、0.02p；查看 raw 确认实际存储时间网格。
STOP=300p
# 可选格式：数字 + p 或 ps；CHAIN 本批要求至少 300 ps。

# Probe selection. Chain mode captures stage boundaries, selected internal JJ
# states, clocks, link currents, and DFF output within the raw storage guard.
PROBE_PROFILE=t1_chain_focus
# 可选值：terminal=compact/focus/debug；独立 T1=t1_array_focus；CHAIN=t1_chain_focus。
FOCUS_DIAGONAL=D3
# 可选值：D0、D1、D2、D3、D4、D5、D6；focus 页面选取该对角线的内部器件。
FOCUS_STAGE=D3
# 可选值：D0～D6；stage_focus.html 只展开所选级内部 JJ。

# Serial sJTL count at each level of each diagonal, before that level's CB.
# Required list lengths D0..D6 are 1,2,3,4,3,2,1; entries are nonnegative:
# 0 connects MERGE directly to CB, 1 is one sJTL, >1 is a serial chain.
SJTL_COUNT_D0=1
# 可选值：一个或多个非负整数（逗号分隔）；D0 有 1 层，例如 0、1、2。
SJTL_COUNT_D1=1,1
# 可选值：恰好 2 个非负整数；例如 0,1、1,1、1,2。
SJTL_COUNT_D2=1,2,1
# 可选值：恰好 3 个非负整数；例如 0,1,1、1,1,1、1,2,1。
SJTL_COUNT_D3=1,2,2,1
# 可选值：恰好 4 个非负整数；例如 0,1,1,1、1,1,1,1、1,2,2,1。
SJTL_COUNT_D4=1,2,1
# 可选值：恰好 3 个非负整数；例如 1,1,1 或 1,2,1。
SJTL_COUNT_D5=1,1
# 可选值：恰好 2 个非负整数；例如 1,1 或 1,2。
SJTL_COUNT_D6=1
# 所有 SJTL_COUNT：0 表示 MERGE 直接接 CB；正整数表示该层串联 sJTL 数。
# 计数越大 raw 越大；先用 --dry-run 查看静态配置和 raw 体积估算。
