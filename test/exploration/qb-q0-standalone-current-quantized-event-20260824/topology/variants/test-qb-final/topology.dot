"e_XBQ" [shape=box, style="rounded,filled", fillcolor="white", label="XBQ\n[X] IBIAS BQ"];
"e_R_LOAD" [shape=box, style="rounded,filled", fillcolor="white", label="R_LOAD\n[R] 10"];
