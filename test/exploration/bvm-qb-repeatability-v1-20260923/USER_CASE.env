# BVM array -> JSL -> QB -> JTL repeated-read/recovery platform.
# AUTO inherits from the selected candidate profile or REFERENCE.env.

NAME=RR_QB2X1_N1
EXECUTION_SCOPE=REGRESSION_MATRIX
TEST_MODE=REPEAT_READ
CANDIDATE=QB_2X1
ARRAY_SIZE=AUTO
MASK=01

# Repeated-read timing (ps, unless an explicit unit suffix is shown).
READ_START_PS=110
READ_PERIOD_PS=20
READ_COUNT=5
READ_WIDTH_PS=11
READ_RISE_PS=1
READ_FALL_PS=1
READ_AMP_UA=100
RECOVERY_TAIL_PS=100

# Existing write protocol; kept configurable for later authorized work.
WRITE0_START_PS=50
CONTROL_START_PS=70
WRITE1_START_PS=90
WRITE_WIDTH_PS=11
WRITE_RISE_PS=1
WRITE_FALL_PS=1
WRITE_AMP_UA=100
CONTROL_WIDTH_PS=11
CONTROL_RISE_PS=1
CONTROL_FALL_PS=1
CONTROL_WL_AMP_UA=100
CONTROL_BL_AMP_UA=0
CONTROL_SE_AMP_UA=100

# Rewrite/read sequence. READ_COUNT is derived from STATE_SEQUENCE in this mode.
REWRITE_START_PS=50
STATE_SEQUENCE=00,01,11
STATE_INTERVAL_PS=70
RESET_TO_WRITE_DELAY_PS=20
WRITE_TO_READ_DELAY_PS=25
READ_TO_NEXT_RESET_DELAY_PS=14

# Solver and automatically-computed tail.
DT=0.1p
TAIL_MARGIN_MIN_PS=40
TAIL_MARGIN_PERIODS=2

# Registered, descriptive candidate-navigation settings; not event/SFQ gates.
BJ2_CANDIDATE_THRESHOLD_UV=100
BJ2_CANDIDATE_GAP_PS=0.5
TERMINAL_CANDIDATE_THRESHOLD_UV=100
TERMINAL_CANDIDATE_GAP_PS=0.5
LATENCY_MIN_PS=0
LATENCY_MAX_PS=25

# PRE/POST/NEXT_PRE sample windows (ps).
PRE_WINDOW_PS=1
POST_OFFSET_PS=2
POST_WINDOW_PS=3

# AUTO means use the selected fan-in-specific candidate profile.
JM1_AREA=AUTO
JM2_AREA=AUTO
RJM1=AUTO
RJM2=AUTO
LM1=AUTO
LM2=AUTO
LM3=AUTO
LPM=AUTO
JS1_AREA=AUTO
JS2_AREA=AUTO
RSH_JS1=AUTO
RSH_JS2=AUTO
LS1=AUTO
LS2=AUTO
LS3=AUTO
RS=AUTO
LPSL=AUTO
RSL=AUTO
LSL=AUTO
RBL=AUTO
LPBL=AUTO
RWL=AUTO
LPWL=AUTO
RSE=AUTO
LPSE=AUTO
QB_LIN=AUTO
QB_BJS_AREA=AUTO
QB_L1=AUTO
QB_L2=AUTO
QB_BJ1_AREA=AUTO
QB_RJ1=AUTO
QB_BJ2_AREA=AUTO
QB_RJ2=AUTO
QB_L3=AUTO
QB_IB=AUTO

# Sweeps are opt-in and disabled for the registered platform regressions.
SWEEP_ENABLED=no
SWEEP_KEY=NONE
SWEEP_VALUES=
