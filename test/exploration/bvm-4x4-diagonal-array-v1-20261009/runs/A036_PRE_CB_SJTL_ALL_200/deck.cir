* Physical ripple chain: D0-JTL -> T1_D0; Dk + C(k-1) -> CBU_Dk -> T1_Dk.
V_BIAS1_D0 N_BIAS1_D0 0 DC 1.8m
V_BIAS2_D0 N_BIAS2_D0 0 DC 1.8m
V_BIAS3_D0 N_BIAS3_D0 0 DC 1.8m
R_S_D0 S_D0 0 12
V_TRIG_CLK_D0 CLK_RAW_D0 0 PWL(0p 0 200p 0 201p 1.2m 203p 1.2m 204p 0)
R_TRIG_CLK_D0 CLK_RAW_D0 CLK_D0 2
XT1_D0 T1_I_D0 CLK_D0 S_D0 C_D0 N_BIAS1_D0 N_BIAS2_D0 N_BIAS3_D0 T1
V_BIAS1_D1 N_BIAS1_D1 0 DC 1.8m
V_BIAS2_D1 N_BIAS2_D1 0 DC 1.8m
V_BIAS3_D1 N_BIAS3_D1 0 DC 1.8m
R_S_D1 S_D1 0 12
V_TRIG_CLK_D1 CLK_RAW_D1 0 PWL(0p 0 200p 0 201p 1.2m 203p 1.2m 204p 0)
R_TRIG_CLK_D1 CLK_RAW_D1 CLK_D1 2
XT1_D1 T1_I_D1 CLK_D1 S_D1 C_D1 N_BIAS1_D1 N_BIAS2_D1 N_BIAS3_D1 T1
V_BIAS1_D2 N_BIAS1_D2 0 DC 1.8m
V_BIAS2_D2 N_BIAS2_D2 0 DC 1.8m
V_BIAS3_D2 N_BIAS3_D2 0 DC 1.8m
R_S_D2 S_D2 0 12
V_TRIG_CLK_D2 CLK_RAW_D2 0 PWL(0p 0 200p 0 201p 1.2m 203p 1.2m 204p 0)
R_TRIG_CLK_D2 CLK_RAW_D2 CLK_D2 2
XT1_D2 T1_I_D2 CLK_D2 S_D2 C_D2 N_BIAS1_D2 N_BIAS2_D2 N_BIAS3_D2 T1
V_BIAS1_D3 N_BIAS1_D3 0 DC 1.8m
V_BIAS2_D3 N_BIAS2_D3 0 DC 1.8m
V_BIAS3_D3 N_BIAS3_D3 0 DC 1.8m
R_S_D3 S_D3 0 12
V_TRIG_CLK_D3 CLK_RAW_D3 0 PWL(0p 0 200p 0 201p 1.2m 203p 1.2m 204p 0)
R_TRIG_CLK_D3 CLK_RAW_D3 CLK_D3 2
XT1_D3 T1_I_D3 CLK_D3 S_D3 C_D3 N_BIAS1_D3 N_BIAS2_D3 N_BIAS3_D3 T1
V_BIAS1_D4 N_BIAS1_D4 0 DC 1.8m
V_BIAS2_D4 N_BIAS2_D4 0 DC 1.8m
V_BIAS3_D4 N_BIAS3_D4 0 DC 1.8m
