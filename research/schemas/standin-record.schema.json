{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://josim-bvm.local/schemas/standin-record.schema.json",
  "title": "JoSIM handoff stand-in record",
  "description": "Records a user-authorized Claude stand-in action performed while Codex is unavailable. PROVISIONAL until Codex writes a standin review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "document_type",
    "schema_version",
    "task_id",
    "revision",
    "standin_id",
    "created_at",
    "reason",
    "user_authorization",
    "proxy_agent",
    "status",
    "actions",
    "bindings",
    "declaration"
  ],
  "properties": {
    "protocol": { "const": "josim-handoff/v1" },
    "document_type": { "const": "standin_record" },
    "schema_version": { "const": 1 },
    "task_id": { "$ref": "#/$defs/task_id" },
    "revision": { "type": "integer", "minimum": 1 },
    "standin_id": { "type": "string", "pattern": "^S[0-9]{2}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "reason": { "type": "string", "minLength": 1 },
    "user_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorized_at", "scope"],
      "properties": {
        "authorized_at": { "type": "string", "format": "date-time" },
        "scope": { "type": "string", "minLength": 1 }
      }
    },
    "proxy_agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "id"],
      "properties": {
        "role": { "const": "CLAUDE_CODE" },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "status": { "const": "PROVISIONAL" },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "target_path", "new_sha256", "notes"],
        "properties": {
          "action": {
            "enum": [
              "ISSUE_REQUEST",
              "SUPERSEDE_REQUEST",
              "AUDIT_VERDICT",
              "STATE_SYNC",
              "OTHER"
            ]
          },
          "target_path": { "$ref": "#/$defs/repo_path" },
          "previous_sha256": {
            "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
          },
          "new_sha256": { "$ref": "#/$defs/sha256" },
          "notes": { "type": "string", "minLength": 1 }
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_sha256"],
      "properties": {
        "request_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "declaration": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "task_id": { "type": "string", "pattern": "^JH-[0-9]{8}-[A-Z0-9][A-Z0-9-]*-[0-9]{3}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "repo_path": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "\\\\" },
          { "pattern": "^/" },
          { "pattern": "^\\./" },
          { "pattern": "(^|/)(\\.|\\.\\.)(/|$)" }
        ]
      }
    }
  }
}
