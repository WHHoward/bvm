# Cross-cycle input ownership case A.
# Edit this file and run ./configure.sh; no JoSIM is launched by configure.sh.
# Timing values are picoseconds (ps). ROUND_CASES overrides A/B per read round.

CASE_NAME=V7A_MIXED_80_P68
A=15
B=7
ROUNDS=3
ROUND_CASES=15:7,0:0,0:0

READ_INTERVAL_PS=80
CLOCK_PERIOD_PS=80
SE_CLOCK_DELAY_PS=68

WRITE_START_PS=50
FIRST_READ_PS=110
DT_PS=0.01
TAIL_PS=70
STOP_PS=
PROBES=outputs-clocks
