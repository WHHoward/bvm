{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://josim-bvm.local/schemas/standin-review.schema.json",
  "title": "JoSIM handoff stand-in review",
  "description": "Codex review of a user-authorized Claude stand-in record. Written by Codex after availability returns; does not overwrite the record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "document_type",
    "schema_version",
    "task_id",
    "revision",
    "standin_id",
    "created_at",
    "reviewer",
    "verdict",
    "bindings",
    "notes"
  ],
  "properties": {
    "protocol": { "const": "josim-handoff/v1" },
    "document_type": { "const": "standin_review" },
    "schema_version": { "const": 1 },
    "task_id": { "$ref": "#/$defs/task_id" },
    "revision": { "type": "integer", "minimum": 1 },
    "standin_id": { "type": "string", "pattern": "^S[0-9]{2}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "id"],
      "properties": {
        "role": { "enum": ["CODEX", "THIRD_PARTY"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "verdict": { "enum": ["CONFIRMED", "REWORK_REQUIRED", "REJECTED"] },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_sha256",
        "request_sha256",
        "request_signature_sha256"
      ],
      "properties": {
        "record_sha256": { "$ref": "#/$defs/sha256" },
        "request_sha256": { "$ref": "#/$defs/sha256" },
        "request_signature_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "notes": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "task_id": { "type": "string", "pattern": "^JH-[0-9]{8}-[A-Z0-9][A-Z0-9-]*-[0-9]{3}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
