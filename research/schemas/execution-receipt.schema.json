{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://josim-bvm.local/schemas/execution-receipt.schema.json",
  "title": "JoSIM handoff execution receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "document_type",
    "schema_version",
    "task_id",
    "revision",
    "attempt_id",
    "workflow_state",
    "created_at",
    "executor",
    "bindings",
    "execution_status",
    "baseline_git_head",
    "result_git_head",
    "changes",
    "artifacts",
    "commands",
    "tests",
    "acceptance_results",
    "observations",
    "interpretations",
    "unknowns",
    "proposed_physical_verdict",
    "limitations",
    "deviations",
    "blockers"
  ],
  "properties": {
    "protocol": {
      "const": "josim-handoff/v1"
    },
    "document_type": {
      "const": "execution_receipt"
    },
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "$ref": "#/$defs/task_id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "attempt_id": {
      "$ref": "#/$defs/attempt_id"
    },
    "workflow_state": {
      "enum": [
        "DELIVERED",
        "BLOCKED",
        "DEVIATED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "executor": {
      "$ref": "#/$defs/actor"
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_sha256",
        "ack_sha256"
      ],
      "properties": {
        "request_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "ack_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "execution_status": {
      "enum": [
        "COMPLETED",
        "BLOCKED",
        "DEVIATED"
      ]
    },
    "baseline_git_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "result_git_head": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{7,64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "action",
          "sha256"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/repo_path"
          },
          "action": {
            "enum": [
              "CREATED",
              "MODIFIED",
              "DELETED",
              "RENAMED"
            ]
          },
          "sha256": {
            "oneOf": [
              {
                "$ref": "#/$defs/sha256"
              },
              {
                "type": "null"
              }
            ]
          },
          "previous_path": {
            "$ref": "#/$defs/repo_path"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "action": {
                  "const": "DELETED"
                }
              },
              "required": [
                "action"
              ]
            },
            "then": {
              "properties": {
                "sha256": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "sha256": {
                  "$ref": "#/$defs/sha256"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "const": "RENAMED"
                }
              },
              "required": [
                "action"
              ]
            },
            "then": {
              "required": [
                "previous_path"
              ]
            }
          }
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "sha256",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "path": {
            "$ref": "#/$defs/repo_path"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "role": {
            "enum": [
              "IMPLEMENTATION",
              "TEST",
              "RAW",
              "LOG",
              "MANIFEST",
              "DOCUMENTATION"
            ]
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "exit_code",
          "log_path",
          "log_sha256"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "exit_code": {
            "type": "integer"
          },
          "log_path": {
            "$ref": "#/$defs/repo_path"
          },
          "log_sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "evidence_paths",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN"
            ]
          },
          "evidence_paths": {
            "$ref": "#/$defs/path_list"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "PASS",
                    "FAIL"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "evidence_paths": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "NOT_RUN"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "notes": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "acceptance_results": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "evidence_paths",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "status": {
            "enum": [
              "SATISFIED",
              "NOT_SATISFIED",
              "NOT_EVALUATED"
            ]
          },
          "evidence_paths": {
            "$ref": "#/$defs/path_list"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "SATISFIED",
                    "NOT_SATISFIED"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "evidence_paths": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "NOT_EVALUATED"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "notes": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "interpretations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "proposed_physical_verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE",
        "NOT_APPLICABLE"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_bundle": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution_status": {
            "const": "COMPLETED"
          }
        },
        "required": [
          "execution_status"
        ]
      },
      "then": {
        "properties": {
          "workflow_state": {
            "const": "DELIVERED"
          },
          "blockers": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_status": {
            "const": "BLOCKED"
          }
        },
        "required": [
          "execution_status"
        ]
      },
      "then": {
        "properties": {
          "workflow_state": {
            "const": "BLOCKED"
          },
          "blockers": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_status": {
            "const": "DEVIATED"
          }
        },
        "required": [
          "execution_status"
        ]
      },
      "then": {
        "properties": {
          "workflow_state": {
            "const": "DEVIATED"
          },
          "deviations": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "task_id": {
      "type": "string",
      "pattern": "^JH-[0-9]{8}-[A-Z0-9][A-Z0-9-]*-[0-9]{3}$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^A[0-9]{2,}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repo_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!\\./)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
    },
    "path_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/repo_path"
      },
      "uniqueItems": true
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "id"
      ],
      "properties": {
        "role": {
          "const": "CLAUDE_CODE"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}