# Canonical reference extracted from the current BVM authority source.
# Do not edit manually. Source SHA is checked before future physical runs.
CANONICAL_BVM_SOURCE_SHA256=0093a45cc3910448b484d8bd004c6df8c22358bacc8b3ed5e23912dcab805d54

# S-loop junctions
JM1_AREA=1.2
JM2_AREA=1.4
RJM1=8
RJM2=OPEN

# S-loop inductors
LM1=12.5p
LM2=24.5p
LM3=8.5p
LPM=0.5p

# R-loop junctions and branches
JS1_AREA=0.74
JS2_AREA=0.74
RSH_JS1=OPEN
RSH_JS2=OPEN
LS1=0.5p
LS2=0.5p
LS3=0.5p
RS=3.0

# Output chain
LPSL=0.5p
RSL=12.0
LSL=0.4p

# Input / parasitic branches
RBL=20.0
LPBL=0.5p
RWL=20.0
LPWL=0.5p
RSE=20.0
LPSE=0.5p

# Global simulation
DT=0.1p
STOP=200p
IDLE_START=0p
IDLE_END=50p
RECOVERY_END=130p
TAIL_START=150p

# Operation timing
WRITE0_START=50p
WRITE0_END=61p
CONTROL_READ_START=70p
CONTROL_READ_END=81p
WRITE1_START=90p
WRITE1_END=101p
FINAL_READ_START=110p
FINAL_READ_END=121p

# WRITE0 pulse amplitudes
WRITE0_WL_AMP=-100u
WRITE0_BL_AMP=-100u
WRITE0_SE_AMP=0u

# CONTROL READ pulse amplitudes
CONTROL_WL_AMP=100u
CONTROL_BL_AMP=0u
CONTROL_SE_AMP=100u

# WRITE1 pulse amplitudes
WRITE1_WL_AMP=100u
WRITE1_BL_AMP=100u
WRITE1_SE_AMP=0u

# FINAL READ pulse amplitudes; applied only to active mask bits
READ_WL_AMP=100u
READ_BL_AMP=0u
READ_SE_AMP=100u

# Per-path rise/fall. Plateau is derived from operation END-START-rise-fall.
WRITE0_WL_RISE=1p
WRITE0_WL_FALL=1p
WRITE0_BL_RISE=1p
WRITE0_BL_FALL=1p
WRITE0_SE_RISE=1p
WRITE0_SE_FALL=1p
CONTROL_WL_RISE=1p
CONTROL_WL_FALL=1p
CONTROL_BL_RISE=1p
CONTROL_BL_FALL=1p
CONTROL_SE_RISE=1p
CONTROL_SE_FALL=1p
WRITE1_WL_RISE=1p
WRITE1_WL_FALL=1p
WRITE1_BL_RISE=1p
WRITE1_BL_FALL=1p
WRITE1_SE_RISE=1p
WRITE1_SE_FALL=1p
READ_WL_RISE=1p
READ_WL_FALL=1p
READ_BL_RISE=1p
READ_BL_FALL=1p
READ_SE_RISE=1p
READ_SE_FALL=1p

