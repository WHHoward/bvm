NAME=bvm_2x2_rowcol_selection
DRIVE_MODE=SHARED
# Older configs/presets default to SHARED_COLUMN + COLUMN.
SE_TOPOLOGY=CELL
SE_GATE_MODE=CROSSPOINT
ROW_BITS=10
COL_BITS=11

# Per-cell amplitudes in INDEPENDENT; per-line candidates in SHARED.
ROW_WL_READ_AMPLITUDE=200u
COL_SE_READ_AMPLITUDE=100u
ROW_WL_WRITE_AMPLITUDE=200u
COL_BL_WRITE_AMPLITUDE=200u

# Fixed uniform downstream load: QB -> one sJTL -> one CB -> R_TERM.
SJTL_PER_CELL=1
POST_CB_PER_CELL=1
TERM_R=2

DT=0.01p
STOP=250p
PROBE_PROFILE=core
OUTPUT_MODE=TERMINAL

# T1 Bias B defaults (used only when OUTPUT_MODE=T1_C1)
T1_BIAS1=1.8m
T1_BIAS2=1.8m
T1_BIAS3=1.8m
T1_BIAS3_SOURCE=VOLTAGE
T1_R_S=12
T1_R_C=12

# A041 clock defaults (used only when OUTPUT_MODE=T1_C1)
T1_CLK_MODE=QUIET
T1_CLK_AMPLITUDE=1.2m
T1_CLK_START=170p
T1_CLK_PERIOD=50p
T1_CLK_RISE=1p
T1_CLK_WIDTH=2p
T1_CLK_FALL=1p
T1_CLK_R_SERIES=2

# Optional repeat read; disabled to preserve the existing one-read default.
SECOND_READ_ENABLE=1
SECOND_ROW_BITS=10
SECOND_COL_BITS=10
