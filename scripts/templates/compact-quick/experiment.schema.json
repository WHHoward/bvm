{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://josim.local/schemas/compact-quick-evidence-first-v1.json",
  "title": "JoSIM Compact Quick evidence-first experiment",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "workflow_policy", "id", "mode", "question",
    "hypothesis", "changed", "frozen", "deck", "run", "analysis",
    "visualization", "scientific_review_authorization", "package"
  ],
  "properties": {
    "schema_version": {"const": "compact-quick-v2"},
    "workflow_policy": {"const": "EVIDENCE_FIRST_V1"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "mode": {"const": "QUICK"},
    "question": {"type": "string", "minLength": 1},
    "hypothesis": {"type": "string", "minLength": 1},
    "changed": {"type": "string", "minLength": 1},
    "frozen": {"oneOf": [{"type": "array", "minItems": 1}, {"type": "object", "minProperties": 1}]},
    "scientific_review_authorization": {"enum": ["NOT_GRANTED", "SCIENTIFIC_REVIEW_AUTHORIZED"]},
    "run": {"type": "object", "required": ["solver"]},
    "analysis": {"type": "object", "required": ["metrics", "signals"]},
    "visualization": {
      "type": "object",
      "required": ["mode", "style", "profile", "signals"],
      "properties": {
        "mode": {"enum": ["compact", "full"]},
        "style": {"const": "CLASSIC_LOCKED"},
        "profile": {"type": "string", "minLength": 1},
        "layers": {"type": "array"},
        "whole_run_overview_ps": {"type": "array", "minItems": 2},
        "focused_windows_ps": {"type": "array"}
      }
    },
    "package": {
      "type": "object",
      "properties": {
        "include_plots": {"type": "boolean"},
        "additional_paths": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
