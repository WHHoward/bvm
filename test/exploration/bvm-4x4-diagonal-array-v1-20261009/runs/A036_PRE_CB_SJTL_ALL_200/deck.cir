XCB_CARRY_D1 CARRY_CB_IN_D1 CARRY_CB_OUT_D1 CB
V_CBU_B_D1 CARRY_CB_OUT_D1 CBU_JOIN_D1 0
V_T1_LINK_D1 CBU_JOIN_D1 T1_I_D1 0
V_CBU_A_D2 DOUT_D2 CBU_JOIN_D2 0
V_CARRY_IN_D2 C_D1 CARRY_SJTL_IN_D2 0
