V_T1_LINK_D6 CBU_JOIN_D6 T1_I_D6 0

* C0-C5 directly drive the next CBU; C6 directly drives the DFF data input.
V_DFF_DATA C_D6 DFF_IN 0
R_DFF_OUT DFF_O 0 12
XDFF DFF_IN CLK_DFF DFF_O THmitll_DFF
V_TRIG_CLK_DFF CLK_RAW_DFF 0 PWL(0p 0 200p 0 201p 1.2m 203p 1.2m 204p 0)
R_TRIG_CLK_DFF CLK_RAW_DFF CLK_DFF 2

